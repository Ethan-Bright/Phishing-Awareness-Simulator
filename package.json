{
  "name": "phishing-awareness-simulator",
  "version": "1.0.0",
  "private": true,
  "description": "Role-based phishing awareness simulator (Eduvos). Aggregate-only reporting, no real credentials stored.",
  "scripts": {
    "build:css": "tailwindcss -i ./src/styles/input.css -o ./public/css/app.css --minify",
    "watch:css": "tailwindcss -i ./src/styles/input.css -o ./public/css/app.css --watch",
    "dev": "firebase emulators:start",
    "deploy": "npm run build:css && firebase deploy"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.13"
  }
}
