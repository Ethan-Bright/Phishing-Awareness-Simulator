rules_version = '2';

// Privacy model for the Phishing Awareness Simulator.
//
// Core promise: aggregate-only reporting, never individual risk profiles.
// The admin dashboard may ONLY read pre-aggregated, non-identifying data.
// Raw response events, per-participant assignment/outcome rows, and the
// anonymised-code registry are NEVER readable by clients. All writes and
// all reads of sensitive collections happen server-side through Cloud
// Functions using the Admin SDK, which bypasses these rules.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Aggregated rollups. No individual data lives here. Admin read-only.
    match /aggregates/{doc} {
      allow read: if isAdmin();
      allow write: if false; // functions only
    }

    match /daily_stats/{doc} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Scenario library + campaign metadata (counts only, no responses).
    match /scenarios/{doc} {
      allow read: if isAdmin();
      // Admin authors drafts in the dashboard. Status starts as pending_review;
      // going live still needs an explicit approve action in the UI.
      allow create: if isAdmin()
        && request.resource.data.status == "pending_review";
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Human-approved quiz emails only. Public read so learners can take the
    // quiz without signing in. Writes are admin-only; drafts never land here.
    match /quiz_live/{doc} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /campaigns/{doc} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Sensitive collections: locked completely to clients.
    // Reached only via the Admin SDK inside Cloud Functions.
    match /events/{doc}            { allow read, write: if false; }
    match /assignments/{doc}       { allow read, write: if false; }
    match /participant_codes/{doc} { allow read, write: if false; }
    match /identity_map/{doc}      { allow read, write: if false; }

    // Default deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
